rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // F03: papel e situação vêm do perfil ATUAL em users/{uid} (escrito só pelo servidor). Revogar/desativar vale
    // na próxima leitura, mesmo com ID token ainda dentro da validade. Conta sem perfil ativo não lê nada.
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.status == 'active';
    }
    function hasRole(roles) { return active() && get(profilePath()).data.role in roles; }
    function isStaff() { return hasRole(['cantina', 'secretaria', 'admin']); }

    // Vínculo responsável-aluno (ID determinístico guardianUid_studentId) e política do aluno: fontes mutáveis.
    function linkPath(studentId) { return /databases/$(database)/documents/guardianStudentLinks/$(request.auth.uid + '_' + studentId); }
    function linkedGuardian(studentId) {
      return hasRole(['guardian']) && exists(linkPath(studentId)) && get(linkPath(studentId)).data.status == 'active';
    }
    function studentSelf(studentId) {
      return hasRole(['student'])
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.userUid == request.auth.uid;
    }

    // Perfil de acesso: o dono lê o próprio (sessão/navegação, inclusive para saber que foi desativado). Sem list.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // Aluno (perfil necessário; sem custos/dados administrativos): equipe, responsável vinculado ativo ou o próprio aluno.
    // Sem list: busca por nome é do servidor; a família chega ao aluno pelos próprios vínculos.
    match /students/{studentId} {
      allow get: if isStaff() || linkedGuardian(studentId) || studentSelf(studentId);
      allow list, write: if false;
    }

    // Vínculos: o responsável lista/lê apenas os próprios vínculos ativos (consulta deve filtrar guardianUid == uid e status == active).
    match /guardianStudentLinks/{linkId} {
      allow get, list: if active() && resource.data.guardianUid == request.auth.uid && resource.data.status == 'active';
      allow write: if false;
    }

    // Política do aluno (permissões de compra, limites, bloqueios): leitura de PDV/administração e da família do aluno.
    // Exceções de compra (uso único): só responsável vinculado e administração leem; escrita só pelo servidor.
    match /studentPolicies/{studentId} {
      allow get: if hasRole(['cantina', 'admin']) || linkedGuardian(studentId) || studentSelf(studentId);
      allow list, write: if false;
      match /exceptions/{exceptionId} {
        allow get, list: if hasRole(['admin']) || linkedGuardian(studentId);
        allow write: if false;
      }
    }

    // F09: comprometimento de consumo por data/semana (valores em centavos): leitura da família, do próprio aluno e do
    // PDV/administração (o PDV usa o servidor; a leitura direta é só para exibir o orçamento). Escrita só pelo servidor,
    // na mesma transação da compra.
    match /studentUsage/{studentId}/{kind}/{key} {
      allow get, list: if (kind == 'days' || kind == 'weeks') && (hasRole(['cantina', 'admin']) || linkedGuardian(studentId) || studentSelf(studentId));
      allow write: if false;
    }

    // F04: turmas e turnos são cadastro público interno (nomes), legíveis por qualquer conta com perfil ativo para
    // montar telas; escrita só pelo servidor (administração). Convites, chaves de unicidade, idempotência e
    // auditoria continuam fechados ao cliente (regra final).
    match /classes/{classId} {
      allow get, list: if active();
      allow write: if false;
    }
    match /shifts/{shiftId} {
      allow get, list: if active();
      allow write: if false;
    }

    // F05: identidade, dias de funcionamento/horários e exceções de calendário são legíveis por qualquer conta com
    // perfil ativo (telas e contagem regressiva); escrita só pelo servidor (administração), com auditoria.
    match /settings/{settingsId} {
      allow get: if active();
      allow list, write: if false;
    }
    match /calendarDays/{dayId} {
      allow get, list: if active();
      allow write: if false;
    }

    // F01: a prova de fundação lê apenas o próprio documento e o próprio livro (qualquer conta autenticada).
    // Escritas ficam sempre negadas ao cliente; comandos passam pelo servidor (Admin SDK).
    match /foundationProbes/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
      match /entries/{entryId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow write: if false;
      }
    }

    // F06: catálogo. Categorias e o cadastro PÚBLICO do produto (nome, descrição, preço em centavos, canais, turnos,
    // modo, foto) são legíveis por qualquer conta com perfil ativo; nunca contêm custo nem fornecedor. Escrita só pelo
    // servidor (administração; foto pela cantina), com auditoria.
    match /categories/{categoryId} {
      allow get, list: if active();
      allow write: if false;
    }
    match /products/{productId} {
      allow get, list: if active();
      allow write: if false;
      // Histórico imutável de preço: operação da cantina e administração (inclui o autor da mudança).
      match /priceHistory/{entryId} {
        allow get, list: if hasRole(['cantina', 'admin']);
        allow write: if false;
      }
    }
    // Dados internos do produto (fornecedor padrão, observações): só administração. Rules autorizam documento inteiro,
    // por isso ficam em coleção separada do cadastro público.
    match /productPrivate/{productId} {
      allow get, list: if hasRole(['admin']);
      allow write: if false;
    }

    // F07: configuração do cardápio (padrão por turno e exceções por data/turno, com motivos internos) — leitura da
    // operação (cantina e administração); a família recebe só o cardápio RESOLVIDO pelo servidor (GET /api/menu).
    // Escrita só pelo servidor (administração), com auditoria. Regras novas apenas acrescentam leitura (expandir).
    match /defaultMenuRules/{productId} {
      allow get, list: if hasRole(['cantina', 'admin']);
      allow write: if false;
    }
    match /menuOverrides/{overrideId} {
      allow get, list: if hasRole(['cantina', 'admin']);
      allow write: if false;
    }

    // F08: carteira individual (saldo projetado + versão) e livro imutável: leitura só do responsável com vínculo ativo
    // ao aluno (cada família vê apenas as próprias carteiras; equipe e aluno usam o servidor). Escrita só pelo servidor,
    // em transação com auditoria. Sem list em wallets; o extrato é consultado por orderBy(seq) com limite.
    match /wallets/{studentId} {
      allow get: if linkedGuardian(studentId);
      allow list, write: if false;
      match /entries/{entryId} {
        allow get, list: if linkedGuardian(studentId);
        allow write: if false;
      }
    }

    // F10: estoque. QUANTIDADES (saldo físico, reservas por data, lotes/validade, reservas ativas e cota/comprometimento
    // por data/turno) são legíveis pela cantina e pela administração e NUNCA contêm custo. CUSTOS (stockCosts: valor do
    // estoque e livro de movimentos com custo) e ENTRADAS (stockReceipts: fornecedor, documento, custo) ficam em coleções
    // separadas e FECHADAS ao cliente (regra final): a administração os lê pela API autorizada (costs.read). Rules
    // autorizam documento inteiro, por isso a separação física. Escrita só pelo servidor, em transação (Admin SDK).
    // Regras novas apenas acrescentam leitura (expandir), compatíveis com a main publicada.
    match /stockBalances/{productId} {
      allow get, list: if hasRole(['cantina', 'admin']);
      allow write: if false;
      match /lots/{lotId} {
        allow get, list: if hasRole(['cantina', 'admin']);
        allow write: if false;
      }
      match /reservations/{reservationId} {
        allow get, list: if hasRole(['cantina', 'admin']);
        allow write: if false;
      }
    }
    match /dailyCapacity/{capacityId} {
      allow get, list: if hasRole(['cantina', 'admin']);
      allow write: if false;
    }
    // Todo o resto (transferências, pedidos, custos, lucro, relatórios, auditoria, idempotência) permanece fechado ao
    // cliente: acesso só por servidor autorizado. Custos/lucro ficarão em coleções de administração (nunca abertas à secretaria).
    match /{document=**} { allow read, write: if false; }
  }
}
