rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // F01: única abertura — a prova de fundação lê apenas o próprio documento e o próprio livro.
    // Escritas ficam sempre negadas ao cliente; comandos passam pelo servidor (Admin SDK).
    match /foundationProbes/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
      match /entries/{entryId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow write: if false;
      }
    }

    // F02: exemplo de catálogo claramente fictício (isolado de relatórios/dados reais). Leitura por conta
    // autenticada; escrita nunca pelo cliente (seed/servidor). Substituído pelo catálogo real em F06.
    match /demoProducts/{productId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    // Todo o resto permanece fechado até F03 (acesso por identidade/vínculo) e tarefas de domínio.
    match /{document=**} { allow read, write: if false; }
  }
}
