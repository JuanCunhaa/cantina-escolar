rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // F03: papel e situação lidos do perfil ATUAL (users/{uid}, regra entre serviços Firestore). Revogação vale
    // imediatamente; a claim do token não é usada. Conta sem perfil ativo não lê nem escreve.
    function profilePath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function activeUser() {
      return request.auth != null && firestore.exists(profilePath()) && firestore.get(profilePath()).data.status == 'active';
    }
    function isPhotoStaff() {
      return activeUser() && firestore.get(profilePath()).data.role in ['admin', 'cantina'];
    }
    function validPhoto() {
      return request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Fotos do cardápio (imutáveis após criadas: substituir = novo arquivo; evita trocar o conteúdo depois da validação do servidor): leitura para conta com perfil ativo; escrita só de funcionário autorizado,
    // com caminho products/{productId}/{arquivo}, tipo e tamanho validados. Rules não inspecionam bytes:
    // o servidor confere metadados ao registrar a foto (/api/catalog/photo).
    match /products/{productId}/{fileName} {
      allow read: if activeUser();
      allow create: if resource == null && isPhotoStaff() && validPhoto() && fileName.matches('[A-Za-z0-9_-]{1,64}[.](jpg|png|webp)');
      allow delete: if isPhotoStaff();
    }

    // Todo o resto (comprovantes, documentos privados, qualquer outro caminho) permanece fechado.
    match /{allPaths=**} { allow read, write: if false; }
  }
}
