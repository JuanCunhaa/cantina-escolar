# Preencher em emulador/homologação. Nenhum segredo real neste arquivo.
# Web SDK público; não é credencial administrativa.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Apenas servidor. Usar variável segura/identidade de workload quando disponível.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Estes nomes são convenções deste projeto; F01 deve implementar sua leitura.
APP_ENV=emulator
APP_BASE_URL=http://localhost:3000
APP_TIME_ZONE=America/Sao_Paulo
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Arquivos (fotos): Cloudflare R2, bucket PRIVADO, só no servidor (nunca NEXT_PUBLIC_*). Um bucket por ambiente:
# staging exige nome com staging/homolog/test; production recusa esses nomes. Em APP_ENV=emulator use apenas
# STORAGE_LOCAL_DIR (disco local, double do R2) e deixe R2_* vazio. Preencher só placeholders aqui; valores reais
# ficam no gerenciador de segredos do ambiente. Token R2 com permissão Object Read & Write restrita ao bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional (jurisdição): https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Somente emulator:
STORAGE_LOCAL_DIR=.local-storage
# Integração opcional (npm run test:r2), somente no shell, contra bucket de homologação:
# R2_TEST_ACCOUNT_ID, R2_TEST_ACCESS_KEY_ID, R2_TEST_SECRET_ACCESS_KEY, R2_TEST_BUCKET

# Convenções dos adapters a implementar; provedor definitivo pendente.
PAYMENTS_ENV=sandbox
PIX_PROVIDER=
CARD_PROVIDER=
PIX_API_KEY=
CARD_API_KEY=
PIX_WEBHOOK_SECRET=
CARD_WEBHOOK_SECRET=
# Credenciais podem exigir campos específicos do provedor: adicionar após F18.
# Hostnames *_EMULATOR_HOST são só servidor; o Web SDK precisa de connect*Emulator.
# Não incluir variáveis de emulador em produção; validar ambiente de forma fechada.

# Opcional (analytics do Web SDK). Não lido pela aplicação ainda.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
