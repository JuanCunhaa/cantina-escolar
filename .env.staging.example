# Homologação integrada (projeto Firebase EXCLUSIVO + bucket R2 de staging). Copie para .env.staging.local (ignorado
# pelo Git) e preencha. Nunca coloque valores reais aqui. O .env do desenvolvedor NÃO é lido pelos comandos staging:*.
# Confirmação explícita do destino: repita o ID do projeto de homologação (deve conter staging/homolog/hml/test).
STAGING_CONFIRM_PROJECT=
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# JSON da conta de serviço do Admin SDK, salvo em arquivo local ignorado pelo Git (Console > Contas de serviço).
FIREBASE_SERVICE_ACCOUNT_FILE=.secrets/<projeto>-admin.json
# R2 da aplicação em staging (bucket exclusivo cantina-fotos-staging; token Object Read & Write restrito ao bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cantina-fotos-staging
# Opcional (jurisdição): R2_ENDPOINT=https://<conta>.eu.r2.cloudflarestorage.com
# Recarga online (opcional; F18). Só sandbox do Mercado Pago, com credenciais de TESTE da conta da escola. Sem estas
# linhas, Pix e cartão ficam indisponíveis na homologação. Nunca credencial de produção aqui.
# PAYMENTS_PIX_PROVIDER=mercadopago
# PAYMENTS_CARD_PROVIDER=mercadopago
# MERCADOPAGO_ENV=sandbox
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
